<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ThoNohT.NohBoard</RootNamespace>
    <StartupObject>ThoNohT.NohBoard.Program</StartupObject>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>NohBoard2.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <!--
      Suppress WinForms WFO1000 design-time serialization warnings. The existing user controls
      expose UI-only properties that are not meant to be serialized via the Designer; adding
      DesignerSerializationVisibility attributes one by one is mechanical and produces no
      behavioral change.
    -->
    <NoWarn>$(NoWarn);WFO1000;WFO0003</NoWarn>

    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyTitle>NohBoard</AssemblyTitle>
    <Description>A free and easy-to-use keyboard visualizer for streaming and recording.</Description>
    <Product>NohBoard</Product>
    <Company>ThoNohT</Company>
    <Copyright>Copyright (c) Eric Bataille and contributors</Copyright>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>

    <PlatformTarget>x64</PlatformTarget>
    <Platforms>AnyCPU;x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\clipper_library\clipper_library.csproj" />
    <ProjectReference Include="..\Hooking\Hooking.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="app.manifest">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Expose internal helpers (AppPaths.PortableMode setter, ErrorReporter formatters, etc.) to the test assembly. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>NohBoard.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
